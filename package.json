{
  "name": "wicky-pastebin",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:server": "bun --hot src/index.ts",
    "dev:css": "sass --watch src/public/css/editor.scss src/public/css/editor.css",
    "dev": "concurrently \"bun run dev:server\" \"bun run dev:css\"",
    "build": "bun run build:css && bun prisma generate && bun build src/index.ts --target=bun --outfile dist/index.js",
    "build:css": "sass src/public/css/editor.scss src/public/css/editor.css",
    "start": "bun dist/index.js"
  },
  "author": {
    "name": "WickyPlays",
    "email": "baottworkspace@gmail.com"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "@fastify/view": "^12.0.0",
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-libsql": "^7.9.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@vercel/ncc": "^0.44.1",
    "concurrently": "^10.0.4",
    "ejs": "^6.0.1",
    "fastify": "^5.10.0",
    "highlight.js": "^11.11.1",
    "pg": "^8.22.0",
    "prisma": "^7.9.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/ejs": "^3.1.5",
    "@types/node": "^26.1.1",
    "sass": "^1.101.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
}
