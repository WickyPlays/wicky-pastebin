<!DOCTYPE html>
<html lang="en">

<head>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>
  <div class="header">
    <div class="header-left">
      <h1>Wicky Pastebin</h1>
    </div>
    <div class="header-right">
      <div class="icon" id="save" title="Save">
        <img src="/img/icons/save.svg" alt="Save" />
      </div>
      <div class="icon" id="info" title="Info">
        <img src="/img/icons/info.svg" alt="Info" />
      </div>
    </div>
  </div>
  <textarea class="editor" id="editor" placeholder="Type or paste your content here..."></textarea>
  <script>
    document.getElementById('save').addEventListener('click', async () => {
      const content = document.getElementById('editor').value;
      if (!content.trim()) return alert('Please enter some content');

      const response = await fetch('/documents', {
        method: 'POST',
        body: content
      });

      const { key } = await response.json();
      window.location.href = '/' + key;
    });

    document.getElementById('info').addEventListener('click', () => {
      alert('Wicky Pastebin - Simple text sharing');
    });
  </script>
</body>

</html>